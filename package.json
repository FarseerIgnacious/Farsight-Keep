{
  "name": "farsight-keep",
  "version": "1.0.0",
  "description": "A fully offline desktop companion app for D&D 5e Dungeon Masters — manage encounters, monsters, NPCs, PCs, spells, and campaigns without needing an internet connection.",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron ."
  },
  "keywords": [],
  "author": {
    "name": "Farsight Keep",
    "email": "307265924+FarseerIgnacious@users.noreply.github.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1",
    "playwright": "^1.61.0"
  },
  "build": {
    "appId": "com.dmscompanion.app",
    "productName": "Farsight Keep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!.nvmrc",
      "!.git",
      "!.gitignore"
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  }
}
